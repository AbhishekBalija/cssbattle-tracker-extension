{
  "manifest_version": 3,
  "name": "CSSBattle Tracker",
  "version": "1.3.0",
  "description": "Review CSSBattle solution drafts and push named approaches to your GitHub repository",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://cssbattle.dev/*",
    "https://api.github.com/*",
    "https://us-central1-cssbattleapp.cloudfunctions.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cssbattle.dev/*"],
      "js": [
        "plugins/blank-template.js",
        "plugins/nested-template.js",
        "plugins/minify.js",
        "plugins/unit-replacement.js",
        "plugin-manager.js",
        "content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://cssbattle.dev/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
